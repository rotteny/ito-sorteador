# Copie para .env.deploy (fora do git) e preencha. Formato CHAVE=valor, sem aspas e sem "export".
# Variaveis ja definidas no ambiente (ex.: secrets do CI) tem prioridade sobre este arquivo.

DEPLOY_HOST=203.0.113.10
DEPLOY_PORT=22
DEPLOY_USER=deploy

# Com chave restrita por rrsync (authorized_keys: command="rrsync /var/www/site/"),
# o caminho e RELATIVO a pasta liberada: use "/" para a raiz do site.
# Com uma chave sem restricao, use o caminho absoluto (ex.: /var/www/site/).
DEPLOY_PATH=/

PUBLIC_URL=https://example.com

# Opcionais
# DEPLOY_KEY=~/.ssh/deploy_ed25519
# DEPLOY_KNOWN_HOSTS_FILE=~/.ssh/deploy_known_hosts
# SKIP_BUILD=1
